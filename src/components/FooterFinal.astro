---
import '../styles/sections/contacto-final.css';
---

<footer class="final-footer">
	<div class="final-footer-main">
		<div class="final-footer-brand">
			<a class="final-footer-lockup" href="/" aria-label="HELIX, inicio"><img src="/helix-emblem.png" width="40" height="40" alt="" /><span>HELIX</span></a>
			<p><span data-es="Ingeniería operativa" data-en="Operational engineering">Ingeniería operativa</span><br /><span data-es="desde Colombia." data-en="from Colombia.">desde Colombia.</span></p>
		</div>
		<nav aria-label="Menú del pie de página" data-es-aria="Menú del pie de página" data-en-aria="Footer menu">
			<strong data-es="MENÚ" data-en="MENU">MENÚ</strong>
			<a href="#soluciones" data-es="Qué resolvemos" data-en="What we solve">Qué resolvemos</a>
			<a href="#proceso" data-es="Cómo trabajamos" data-en="How we work">Cómo trabajamos</a>
			<a href="#casos" data-es="Casos" data-en="Cases">Casos</a>
			<a href="#contacto" data-es="Contacto" data-en="Contact">Contacto</a>
		</nav>
		<div class="final-footer-social">
			<strong data-es="REDES" data-en="SOCIAL">REDES</strong>
			<a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
			<a href="https://www.instagram.com/" target="_blank" rel="noreferrer">Instagram ↗</a>
		</div>
		<div class="final-footer-contact">
			<strong data-es="CONTACTO" data-en="CONTACT">CONTACTO</strong>
			<a href="mailto:hola@helix.co">hola@helix.co</a>
			<span>Colombia · UTC−5</span>
			<span class="colombia-time" data-colombia-time aria-label="Hora de Colombia" data-es-aria="Hora de Colombia" data-en-aria="Colombia time"></span>
		</div>
	</div>
	<div class="final-footer-bottom">
		<span>© 2026 HELIX</span>
		<div><a href="#top" data-es="Volver arriba ↑" data-en="Back to top ↑">Volver arriba ↑</a><span data-es="Todos los derechos reservados" data-en="All rights reserved">Todos los derechos reservados</span></div>
		<div class="language-switcher" aria-label="Selector de idioma"><button type="button" data-lang="es" aria-pressed="true">ES</button><button type="button" data-lang="en" aria-pressed="false">EN</button></div>
	</div>
</footer>
